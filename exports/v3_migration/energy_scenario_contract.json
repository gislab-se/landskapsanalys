{
  "schema_version": "v3_energy_scenario_contract_v0",
  "status": "proposal_from_v2_inventory",
  "v2_sources": {
    "energy_modeling_module": "apps/potential_model/energy_modeling.py",
    "app_wrapper": "potential_app.py",
    "bornholm_scenario_manifest": "apps/potential_model/manifests/scenarios/bornholm_scenarios_placeholder.json",
    "trondelag_scenario_manifest": "apps/potential_model/manifests/scenarios/trondelag_scenarios_placeholder.json",
    "vara_region_manifest": "apps/potential_model/manifests/regions/vara.json"
  },
  "required_input_fields": {
    "region": [
      "region_id",
      "native_crs",
      "available_h3_resolutions",
      "default_h3_resolution",
      "default_display_h3_resolution"
    ],
    "scenario_manifest": [
      "scenario_set_id",
      "status",
      "energy_model.duckdb.path",
      "energy_model.duckdb.source_tables",
      "energy_model.duckdb.columns",
      "energy_model.duckdb.filters",
      "energy_model.duckdb.technology_map",
      "energy_model.area_demand.path",
      "energy_model.area_demand.times_technology_map",
      "energy_model.area_demand.technology_rows",
      "energy_model.area_demand.quality_rules",
      "energy_model.planning.scenarios"
    ],
    "applied_state": [
      "planning_scenario_id",
      "area_scenario_id",
      "solar_share_pct",
      "analysis_h3_resolution"
    ]
  },
  "required_output_fields": {
    "energy_model_state": [
      "available",
      "scenario",
      "scenario_label",
      "source_scenario",
      "source_year",
      "energy_scale",
      "area_scenario_id",
      "area_scenario_label",
      "wind_share_pct",
      "solar_share_pct",
      "native_wind_share_pct",
      "native_solar_share_pct",
      "wind_twh",
      "solar_twh",
      "wind_km2_per_twh",
      "solar_km2_per_twh",
      "wind_area_need_km2",
      "solar_area_need_km2",
      "auto_min_potential_share_pct",
      "source_status",
      "data_status"
    ],
    "area_demand_rows": [
      "energy_key",
      "times_tech",
      "twh",
      "km2_per_twh",
      "area_need_km2"
    ]
  },
  "v2_defaults": {
    "manifest_default_planning_scenario": "medium",
    "app_start_planning_scenario": "high",
    "app_start_area_scenario": "high",
    "app_start_solar_share_pct": 50,
    "app_start_wind_share_pct": 50,
    "auto_min_potential_share_pct": 65,
    "notes": [
      "Both Bornholm and Trondelag scenario manifests declare default_scenario = medium.",
      "The current V2 app start state overrides to high/high through _ensure_default_start_state.",
      "The V2 mix slider defaults to 50 percent solar, hence 50 percent wind."
    ]
  },
  "scenario_levels": {
    "planning": {
      "low": {
        "source_scenario": "ENERGYISLAND2050",
        "planning_year": 2050,
        "energy_scale": 0.65,
        "default_area_demand_scenario_from_manifest": "low"
      },
      "medium": {
        "source_scenario": "ENERGYISLAND2050",
        "planning_year": 2050,
        "energy_scale": 1,
        "default_area_demand_scenario_from_manifest": "mid"
      },
      "high": {
        "source_scenario": "ENERGYISLAND2050",
        "planning_year": 2050,
        "energy_scale": 1.25,
        "default_area_demand_scenario_from_manifest": "high"
      }
    },
    "area_demand": [
      "low",
      "mid",
      "high"
    ]
  },
  "technology_mapping": {
    "wind": "NRG_WIN",
    "solar": "NRG_SOL"
  },
  "calculation": {
    "select_planning_mix": [
      "Filter TIMES mix by source_scenario.",
      "Filter by planning_year.",
      "Multiply value_twh by energy_scale."
    ],
    "balance_wind_solar_mix": [
      "Compute total TWh after planning mix.",
      "Set solar TWh to total_twh * solar_share_pct / 100.",
      "Set wind TWh to total_twh * (1 - solar_share_pct / 100)."
    ],
    "calculate_area_demand": [
      "For each energy_key, sum value_twh.",
      "Look up km2_per_twh from factors_by_scenario[area_scenario_id][times_tech].",
      "area_need_km2 = twh * km2_per_twh."
    ]
  },
  "region_status": {
    "bornholm": {
      "region_status": "active",
      "native_crs": "EPSG:25833",
      "available_h3_resolutions": [
        6,
        7,
        8,
        9,
        10
      ],
      "default_h3_resolution": 10,
      "default_display_h3_resolution": 8,
      "scenario_status": "prototype",
      "scenario_manifest": "apps/potential_model/manifests/scenarios/bornholm_scenarios_placeholder.json",
      "duckdb_path": "data/processed/speedlocal_times.duckdb",
      "area_demand_path": "data/raw/AreaDemand.xlsx",
      "data_status": {
        "energy_model": "prototype",
        "area_demand": "prototype",
        "social_acceptance": "synthetic"
      }
    },
    "trondelag": {
      "region_status": "active",
      "native_crs": "EPSG:25832",
      "available_h3_resolutions": [
        7,
        6,
        5
      ],
      "default_h3_resolution": 7,
      "default_display_h3_resolution": 7,
      "scenario_status": "placeholder",
      "scenario_manifest": "apps/potential_model/manifests/scenarios/trondelag_scenarios_placeholder.json",
      "duckdb_path": "data/processed/speedlocal_times.duckdb",
      "area_demand_path": "data/raw/AreaDemand.xlsx",
      "data_status": {
        "energy_model": "placeholder",
        "area_demand": "placeholder",
        "population_settlement": "proxy",
        "social_acceptance": "synthetic",
        "pdf_landscape_types": "experimental"
      },
      "note": "Uses Bornholm ENERGYISLAND2050 TIMES/AreaDemand placeholder until EML or Norwegian equivalent exists."
    },
    "skaraborg": {
      "v2_region_proxy": "vara",
      "region_status": "planned",
      "native_crs": "TBD",
      "available_h3_resolutions": [],
      "default_h3_resolution": null,
      "default_display_h3_resolution": null,
      "scenario_status": "missing",
      "scenario_manifest": null,
      "duckdb_path": null,
      "area_demand_path": null,
      "data_status": {
        "energy_model": "missing",
        "area_demand": "missing",
        "potential_frames": "missing"
      },
      "note": "V2 has no Skaraborg/Vara energy scenario runtime. V3 should not synthesize final results without regional inputs."
    }
  },
  "cache_key_recommendation": {
    "include": [
      "region_id",
      "scenario_set_id",
      "scenario_manifest_hash",
      "duckdb_source_hash_or_version",
      "area_demand_hash_or_version",
      "planning_scenario_id",
      "area_scenario_id",
      "solar_share_pct",
      "technology_to_times",
      "analysis_h3_resolution",
      "data_status"
    ],
    "exclude": [
      "Leaflet overlay visibility",
      "Leaflet base layer",
      "map center",
      "map zoom",
      "draft widget values before apply"
    ]
  },
  "recommended_v3_tests": [
    "test_energy_defaults_high_high_50_50_match_v2_start_state",
    "test_manifest_default_medium_is_not_confused_with_v2_start_default",
    "test_select_planning_mix_filters_source_scenario_and_year",
    "test_select_planning_mix_applies_energy_scale",
    "test_mix_slider_rebalances_wind_solar_twh_without_changing_total_twh",
    "test_calculate_area_demand_multiplies_twh_by_km2_per_twh",
    "test_trondelag_energy_scenario_marked_placeholder",
    "test_skaraborg_energy_scenario_missing_until_manifest_exists",
    "test_energy_cache_key_excludes_map_view_and_layer_visibility"
  ]
}
