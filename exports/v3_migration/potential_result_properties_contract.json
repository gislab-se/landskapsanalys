{
  "schema_version": "v3_potential_result_properties_v0",
  "status": "proposal_from_v2_inventory",
  "coordinate_policy": {
    "analysis_native_crs_by_region": {
      "bornholm": "EPSG:25833",
      "trondelag": "EPSG:25832",
      "vara": "TBD"
    },
    "render_crs": "EPSG:4326",
    "geometry_id": "h3 cell id in hex_id unless explicitly marked schematic or child",
    "notes": [
      "Distance, buffer and area operations should run in the region native CRS.",
      "GeoJSON delivered to rendered_snapshot.layers should be lon/lat EPSG:4326.",
      "Display resolution may differ from analysis resolution; include both when relevant."
    ]
  },
  "class_definitions": {
    "establishment_class": {
      "wind_and_solar": {
        "label": "Vind och sol",
        "color": "#15803d",
        "meaning": "Both wind and solar are suitable in the establishment hex after applied filters."
      },
      "wind_only": {
        "label": "Endast vind",
        "color": "#2563eb",
        "meaning": "Wind is suitable and solar is not suitable in the establishment hex."
      },
      "solar_only": {
        "label": "Endast sol",
        "color": "#facc15",
        "meaning": "Solar is suitable and wind is not suitable in the establishment hex."
      },
      "not_suitable": {
        "label": "Inte lämplig",
        "color": "#991b1b",
        "meaning": "Neither wind nor solar is suitable after applied filters."
      }
    },
    "scenario_allocation_class": {
      "both": {
        "label": "Vind och sol",
        "color": "#166534",
        "meaning": "Both technologies are allocated in the parent establishment hex."
      },
      "wind": {
        "label": "Vind",
        "color": "#1d4ed8",
        "meaning": "Wind scenario area dominates or is the only allocation in the parent establishment hex."
      },
      "solar": {
        "label": "Sol",
        "color": "#f59e0b",
        "meaning": "Solar scenario area dominates or is the only allocation in the parent establishment hex."
      }
    },
    "outside_lp_schematic_technology": {
      "wind": {
        "label": "Vind",
        "meaning": "Schematic remaining wind area demand outside landscape potential."
      },
      "solar": {
        "label": "Sol",
        "meaning": "Schematic remaining solar area demand outside landscape potential."
      }
    }
  },
  "common_layer_spec_fields": {
    "id": "stable rendered layer id",
    "label": "user-facing layer label",
    "layer_kind": "result",
    "result_kind": "potential_establishment_area | scenario_allocation | outside_lp_need",
    "technology_scope": "wind | solar | combined",
    "visible": "default visibility in rendered snapshot",
    "legend_group": "Establishment potential | Scenario allocation | Outside landscape potential",
    "source": {
      "analysis_snapshot_id": "applied/rendered analysis snapshot id",
      "input_fingerprint": "hash of applied inputs and data versions",
      "region_id": "region id",
      "analysis_h3_resolution": "integer",
      "display_h3_resolution": "integer",
      "native_crs": "region native CRS",
      "render_crs": "EPSG:4326"
    },
    "cache_key": "stable cache key for this result layer",
    "style": {
      "fill_property": "fill",
      "stroke_property": "stroke",
      "fill_opacity_property": "fill_opacity",
      "stroke_weight_property": "stroke_weight"
    }
  },
