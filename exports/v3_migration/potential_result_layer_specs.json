      "style": {
        "type": "property",
        "fill_color_property": "fill",
        "stroke_color_property": "stroke",
        "fill_opacity_property": "fill_opacity",
        "stroke_width_property": "stroke_weight",
        "fallback": {
          "fill_color": "#1d4ed8",
          "stroke_color": "#0f172a",
          "fill_opacity": 0.88,
          "stroke_opacity": 0.0,
