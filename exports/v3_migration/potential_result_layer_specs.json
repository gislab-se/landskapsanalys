{
  "schema_version": "v3.result_layers.proposal.2026-06-09",
  "notes": [
    "Neutral V3 layer-spec for result layers. This is not a direct copy of V2's internal layer dict.",
    "Result-layer data should come from applied/rendered_snapshot, not draft widget state.",
    "Map view state should not be scoped to these cache keys."
  ],
  "layers": [
    {
      "id": "result.potential_establishment_area",
      "label": "Potentiell etableringsyta",
      "layer_kind": "result",
      "result_type": "potential_establishment_area",
      "geometry_type": "h3_hex_geojson",
      "visibility": {
        "default_visible": true,
        "user_toggle": true,
        "persist_visibility": true
      },
      "source": {
        "type": "rendered_snapshot",
        "snapshot_path": "rendered_snapshot.layers[result.potential_establishment_area].feature_collection",
        "derived_from": [
          "applied.wind_potential",
          "applied.solar_potential",
          "applied.wind_scenario_allocation",
          "applied.solar_scenario_allocation"
        ],
        "native_crs": "EPSG:4326",
        "render_crs": "EPSG:4326"
      },
      "cache_key": "result:potential_establishment_area:{region_id}:{applied_hash}:{display_resolution}",
      "legend_group": {
        "id": "combined_establishment",
        "label": "Potentiell etableringsyta",
        "items": [
          {
            "value": "wind_and_solar",
            "label": "Vind och sol",
            "color": "#15803d"
          },
          {
            "value": "wind_only",
            "label": "Endast vind",
            "color": "#2563eb"
          },
          {
            "value": "solar_only",
            "label": "Endast sol",
            "color": "#facc15"
          },
          {
            "value": "not_suitable",
            "label": "Inte lämplig",
            "color": "#991b1b"
          }
        ]
      },
      "style": {
        "type": "property",
        "fill_color_property": "fill",
        "stroke_color_property": "stroke",
        "fill_opacity_property": "fill_opacity",
        "stroke_width_property": "stroke_weight",
        "fallback": {
          "fill_color": "#991b1b",
          "stroke_color": "#fee2e2",
          "fill_opacity": 0.58,
          "stroke_opacity": 0.72,
          "stroke_width": 0.12
        },
        "z_index": 476
      },
      "properties": {
        "required": [
          "hex_id",
          "establishment_class",
          "establishment_label",
          "wind_suitable",
          "solar_suitable",
          "fill",
          "stroke"
        ],
        "optional": [
          "wind_allocated_area_km2",
          "solar_allocated_area_km2",
          "outside_lp_shortage",
          "outside_lp_reason",
          "tooltip_title",
          "tooltip_body",
          "popup"
        ]
      }
    },
    {
