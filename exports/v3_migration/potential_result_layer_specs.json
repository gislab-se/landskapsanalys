  "view_state_rule": {
    "do_not_scope_map_view_to": [
      "cache_key",
      "layer id",
      "result_type",
      "rendered_snapshot id",
      "visibility"
    ],
    "recommended_scope": [
      "region_id",
      "map_contract_version",
      "explicit_reset_token"
    ]
  }
}
