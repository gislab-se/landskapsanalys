    "wind_only": {
      "when": "wind_suitable == true and solar_suitable == false",
      "label": "Endast vind",
      "color": "#2563eb"
    },
    "solar_only": {
      "when": "wind_suitable == false and solar_suitable == true",
      "label": "Endast sol",
      "color": "#facc15"
    },
    "not_suitable": {
      "when": "wind_suitable == false and solar_suitable == false",
      "label": "Inte lämplig",
      "color": "#991b1b"
    }
  },
  "suitability_rules_from_v2": {
    "potential_source_frame": [
      "For wind, use potential_area_share_pct or wind_score as potential_score.",
      "For solar, use potential_area_m2 if present, otherwise potential_area_share_pct or solar_score.",
      "suitable is true when potential_area_km2 > 0 and potential_score > 0.",
      "For Trondelag coarse solar display, selected exclusion overlap can force solar_suitable false when filter_share > 0 and small_area is zero."
    ],
    "selected_allocation_frame": [
      "For scenario frames, suitable means allocated_area_km2 > 0 and outside_lp is false.",
      "Outside-LP area is conflict/shortage visualization, not base potential."
    ]
